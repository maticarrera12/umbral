---
import { photo } from '../data/site';

interface Props {
  id: string;
  width: number;
  alt: string;
  class?: string;
  eager?: boolean;
}
const { id, width, alt, class: cls = '', eager = false } = Astro.props;
---

<img
  src={photo(id, width)}
  alt={alt}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : undefined}
  decoding="async"
  class:list={['absolute inset-0 size-full object-cover', cls]}
/>
