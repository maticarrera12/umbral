---
import { footLinks } from '../data/site';

const label = 'mb-2.5 text-xs tracking-[0.14em] uppercase text-bone-lt';
const link = 'text-cream transition-colors duration-150 hover:text-bone-lt';
---

<footer
  class="overflow-hidden bg-ink px-(--edge) pt-[clamp(48px,6vw,96px)] text-sm leading-[1.7] text-cream/70"
>
  <div
    class="grid gap-x-(--gap) gap-y-10 [grid-template-columns:repeat(auto-fit,minmax(min(100%,180px),1fr))]"
  >
    <div class="flex flex-col">
      <p class={label}>Estudio</p>
      <span class="text-cream">Gorriti 4870</span>
      <span>C1414 Palermo, Buenos Aires</span>
      <span>Lunes a viernes, 9 a 18 h</span>
    </div>
    <div class="flex flex-col">
      <p class={label}>Contacto</p>
      <a href="mailto:estudio@umbral.com.ar" class={link}>estudio@umbral.com.ar</a>
      <a href="tel:+541147770000" class={link}>+54 11 4777 0000</a>
      <a href="mailto:prensa@umbral.com.ar" class={link}>prensa@umbral.com.ar</a>
    </div>
    <nav aria-label="Secciones" class="flex flex-col">
      <p class={label}>Secciones</p>
      {footLinks.map(([id, text]) => <a href={`#${id}`} class={link}>{text}</a>)}
    </nav>
    <div class="flex flex-col">
      <p class={label}>Seguinos</p>
      <a href="https://instagram.com" target="_blank" rel="noopener" class={link}>Instagram ↗</a>
      <a href="https://linkedin.com" target="_blank" rel="noopener" class={link}>LinkedIn ↗</a>
      <a href="https://pinterest.com" target="_blank" rel="noopener" class={link}>Pinterest ↗</a>
    </div>
  </div>
  <div
    class="mt-[clamp(48px,6vw,88px)] flex flex-wrap justify-between gap-x-8 gap-y-2 text-xs"
  >
    <span>© 2026 UMBRAL Arquitectura · Matrícula CPAU</span>
    <span>
      Fotografías: Unsplash ·
      <a href="#inicio" class="text-cream/85 transition-colors duration-150 hover:text-bone-lt">Volver arriba ↑</a>
    </span>
  </div>
  <p
    aria-hidden="true"
    class="-mb-[0.2em] -ml-[0.04em] mt-[clamp(12px,2vw,24px)] text-[min(16.5vw,420px)] leading-[0.8] font-semibold tracking-[-0.04em] whitespace-nowrap text-charcoal"
    style="font-stretch:125%"
  >
    UMBRAL
  </p>
</footer>
